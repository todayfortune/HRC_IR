[Unit]
Description=Daily Trend web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stockview
Group=stockview
WorkingDirectory=/opt/stock_view
EnvironmentFile=/opt/stock_view/.env
ExecStart=/opt/stock_view/.venv/bin/python -m app.main --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
PrivateTmp=true

[Install]
WantedBy=multi-user.target
